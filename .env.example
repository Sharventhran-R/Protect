# ==============================================================================
# Autonomous Agentic AI Home Guard - Environment Configuration Template
# ==============================================================================
# WARNING: NEVER COMMIT SENSITIVE SECRETS, CREDENTIALS, OR REAL API KEYS TO VERSION CONTROL.
# Copy this template to '.env' for local development:
#   PowerShell: Copy-Item .env.example .env
# ==============================================================================

# System Runtime Environment
HOME_GUARD_ENV=development
HOME_GUARD_LOG_LEVEL=INFO

# Simulation & Safety Controls (Physical devices/services MUST be mocked)
SIMULATION_MODE=true
DISPATCH_MOCK_ENABLED=true
DRY_RUN_ACTIONS=true

# Storage & Retention Paths
DATA_DIR=./data
RECORDINGS_PATH=./data/recordings
EVIDENCE_PATH=./data/evidence
MODELS_PATH=./models

# Local LLM Reasoning (Phase 4+ targets)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Event & Messaging Infrastructure (Phase 3+ targets)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://guard_user:guard_pass@localhost:5432/home_guard
